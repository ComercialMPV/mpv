# Database
MONGODB_URI=mongodb://localhost:27017/invoice-app

# JWT Secrets
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=noreply@example.com

# Frontend URL (for email links, CORS, etc.)
FRONTEND_URL=http://localhost:5173

# Playwright / Browser Configuration
# For shared hosts, set this to the path of an installed Chromium/Chrome browser
# Example values:
#   /usr/bin/chromium-browser  (Ubuntu/Debian)
#   /usr/bin/google-chrome      (Chrome install)
#   /opt/playwright/.local-chromium/linux-123456/chrome-linux64/chrome  (custom)
# Leave empty to let Playwright auto-detect (requires browser to be pre-installed)
BROWSER_EXECUTABLE_PATH=

# Optional: API Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Optional: Node Environment
NODE_ENV=development
